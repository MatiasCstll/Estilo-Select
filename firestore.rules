rules_version = '2';
// Reglas de seguridad de la base de datos de Estilo Select.
// Pegalas en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }
    function esAdmin() { return logueado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Catálogo: lo ve cualquiera, lo edita solo el admin
    match /productos/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Ajustes de la tienda (envío, WhatsApp, etc.)
    match /config/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Fotos de la página (portada, categorías, nosotros)
    match /imagenes/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Cupones de descuento: se puede consultar uno por su código, pero no ver la lista
    match /cupones/{codigo} {
      allow get: if true;
      allow list, write: if esAdmin();
    }

    // Lista de administradoras: se carga a mano desde la consola de Firebase
    match /admins/{uid} {
      allow read: if logueado() && request.auth.uid == uid;
      allow write: if false;
    }

    // Datos de cada clienta (favoritos)
    match /usuarios/{uid} {
      allow read, write: if logueado() && request.auth.uid == uid;
      allow read: if esAdmin();
    }

    // Pedidos: la clienta crea el suyo (siempre "pendiente") y solo ve los suyos.
    // El pago lo confirma el servidor (webhook de Mercado Pago), nunca el navegador.
    match /pedidos/{id} {
      allow create: if logueado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && !('pagoEstado' in request.resource.data)
        && !('stockDescontado' in request.resource.data);
      allow read: if logueado() && (resource.data.uid == request.auth.uid || esAdmin());
      allow update: if esAdmin();
      allow delete: if false;
    }
  }
}
